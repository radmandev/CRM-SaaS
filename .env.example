# Copy to .env for local development: cp .env.example .env
# Every variable is validated at startup by src/server/env.ts; the app refuses to start on invalid values.

NODE_ENV=development
# Public base URL. Used for links in emails, the CSRF Origin check and cookie security.
APP_URL=http://localhost:3000

# PostgreSQL (docker compose service "postgres")
DATABASE_URL=postgresql://app:app@localhost:5432/travel
# Used only by the test runner (database "travel_test" is created by docker/postgres-init.sql)
TEST_DATABASE_URL=postgresql://app:app@localhost:5432/travel_test

# Signs session cookies and verification tokens. At least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters

# Field encryption for passport/ID numbers, IBANs and integration secrets (SEC-10..12).
# JSON map of key id -> base64 of 32 random bytes. Add a new id and switch ENCRYPTION_ACTIVE_KEY_ID to rotate.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS={"k1":"replace-with-base64-32-bytes"}
ENCRYPTION_ACTIVE_KEY_ID=k1
# Keyed hash for searching encrypted identifiers. At least 32 random characters; never change it after data exists.
HMAC_KEY=replace-me-with-32-plus-random-characters

# Session lifetime (AUTH-10): idle timeout in hours (1-24), absolute lifetime in days
SESSION_IDLE_HOURS=8
SESSION_ABSOLUTE_DAYS=7

# Object storage, any S3-compatible service (docker compose service "s3" = SeaweedFS)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=travel-dev
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_FORCE_PATH_STYLE=true

# Email: smtp (Mailpit locally, UI at http://localhost:8025) | fake (tests only, rejected in production)
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM="Travel SaaS <no-reply@localhost>"

LOG_LEVEL=info
