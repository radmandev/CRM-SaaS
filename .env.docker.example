# Environment for `docker compose --profile app up`. Copy to .env.docker and set a real secret.
NODE_ENV=production
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://app:app@postgres:5432/travel
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=travel-dev
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_FORCE_PATH_STYLE=true
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="Travel SaaS <no-reply@localhost>"
LOG_LEVEL=info

# Field encryption for passport/ID numbers, IBANs and integration secrets (SEC-10..12).
# JSON map of key id -> base64 of 32 random bytes. Add a new id and switch ENCRYPTION_ACTIVE_KEY_ID to rotate.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS={"k1":"replace-with-base64-32-bytes"}
ENCRYPTION_ACTIVE_KEY_ID=k1
# Keyed hash for searching encrypted identifiers. At least 32 random characters; never change it after data exists.
HMAC_KEY=replace-me-with-32-plus-random-characters
