# Environment for `docker compose --profile app up`. Copy to .env.docker and set a real secret.
NODE_ENV=production
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://app:app@postgres:5432/travel
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=travel-dev
S3_ACCESS_KEY_ID=dev
S3_SECRET_ACCESS_KEY=dev
S3_FORCE_PATH_STYLE=true
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
EMAIL_FROM="Travel SaaS <no-reply@localhost>"
LOG_LEVEL=info
