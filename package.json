{
  "name": "travel-agency-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "export RAYON_NUM_THREADS=2 TOKIO_WORKER_THREADS=2 TURBO_TASKS_AVAILABLE_PARALLELISM=2 UV_THREADPOOL_SIZE=2 && next build",
    "start": "next start",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:generate": "prisma generate",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "storage:init": "node --env-file-if-exists=.env --import tsx scripts/init-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.11",
    "libphonenumber-js": "1.13.15",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "playwright-core": "1.64.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  }
}
